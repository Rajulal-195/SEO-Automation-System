# Database (Neon)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Redis (Upstash TCP URL, must start with rediss://)
REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379

# Mock toggle: true runs the full pipeline on mock data
USE_MOCKS=true

# Secret checked by GET /api/cron/audits (send it as the x-cron-secret header)
CRON_SECRET=change-me

# Cron route: process queued jobs inside the cron request.
# Leave false when the Railway worker is running; set true only if there is NO separate worker.
CRON_PROCESS_JOBS=false
# CRON_MAX_JOBS=1

# Claude API (only needed when USE_MOCKS=false)
ANTHROPIC_API_KEY=

# Admin login for the portal (change the password!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Signs session cookies and client dashboard links (random string, 16+ characters).
# Changing it signs everyone out and revokes every client link. Falls back to CRON_SECRET.
AUTH_SECRET=change-me-to-a-long-random-string

# Allows localhost / private-network client URLs (local testing only; leave unset in production)
# ALLOW_PRIVATE_URLS=true

# Worker tuning (optional)
# WORKER_CONCURRENCY=1
# WORKER_DRAIN_DELAY=60
# Demo only: pause (ms) after each progress update so the progress bar is visible
# PIPELINE_STEP_DELAY_MS=1500

# Public URL of the deployed web app (used for the report link in WhatsApp and email)
# APP_BASE_URL=https://your-app.vercel.app

# Real delivery (only used when USE_MOCKS=false)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=+14155238886
# RESEND_API_KEY=
# EMAIL_FROM=Edgelink <reports@yourdomain.com>

# Where the worker saves generated PDFs (optional; defaults to <system temp folder>/reports)
# REPORTS_DIR=/tmp/reports
